# App
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://lumio:lumio@localhost:5432/lumio

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Storage: local | oss
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./backend/storage

# Aliyun OSS (when STORAGE_BACKEND=oss)
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_BASE_URL=

# AI Gateway
AI_GATEWAY_BASE_URL=https://api.openai.com/v1
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=gpt-4o-mini

# Security
SECRET_KEY=change-me-in-production

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
